# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Asset pipeline staging directories (scripts/optimize-assets.mjs) --
# disposable. .staging holds an in-progress run; .complete holds a finished
# run once it's been marked complete, right before it's swapped into
# public/modelView.
public/modelView.staging
public/modelView.complete

# Compressed imaging build, produced by scripts/optimize-assets.mjs from
# assets-src/. Task 12 must bring this under version control when frontend/
# (which currently holds the only committed copy of the assets) is deleted,
# or the deployed site will have no models to serve.
public/modelView/

# Shim modules written by scripts/lib/extract-copy.mjs. They live inside
# web/ rather than the OS tmpdir so Vite's fs.allow boundary covers them;
# each is unlinked in a finally block, so this directory stays empty.
.tmp-extract-copy

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example
